    "tutorial.step2_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je länger die Kette,\ndesto höher die Punkte!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer the chain,\nthe more you score!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Cuanto más larga la cadena,\nmás puntos ganas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus la chaîne est longue,\nplus tu scores !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più lunga è la catena,\npiù alto il punteggio!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長くつなげるほど\nスコアが高くなる!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사슬이 길수록\n점수가 올라가요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe langer de ketting,\nhoe meer punten!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto maior a sequência,\nmaior sua pontuação!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接越长，\n得分越高！"
          }
        }
