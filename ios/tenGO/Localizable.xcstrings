    "booster.hint_coach": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feststeckt? Der Tipp zeigt einen Lösungsweg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuck? The hint flashes a winning path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Atascado? La pista muestra un camino ganador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué ? L'indice fait clignoter un chemin gagnant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato? L'indizio illumina un percorso vincente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き詰まった？ヒントが正解の道筋を光らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혔나요? 힌트가 정답 경로를 보여줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vast? De hint laat een winnend pad zien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Travou? A dica mostra um caminho vencedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡住了？提示会闪烁一条可行路径。"
          }
        }
      }
    },
    "booster.hint_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Lösungsweg, wenn du feststeckst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashes a winning path when you're stuck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un camino ganador cuando te atascas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait clignoter un chemin gagnant quand tu es bloqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illumina un percorso vincente quando sei bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行き詰まったとき、正解の道筋を光らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혔을 때 정답 경로를 깜빡여 알려줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een winnend pad knipperen als je vastzit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um caminho vencedor quando você travar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡住时闪烁提示一条可行路径。"
          }
        }
      }
    },
    "booster.hint_none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Weg hier – versuch's mit Mischen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No path here — try a shuffle"
          }
        },
        "es": {
          "stringUnit": {
