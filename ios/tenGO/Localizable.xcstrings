    "booster.shuffle_coach": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischen verteilt alle Werte neu. Dein Punktestand bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle reshuffles every value. Your score is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mezclador redistribuye todos los valores. Conservas tu puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mélange redistribue toutes les valeurs. Ton score est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mescola ridistribuisce tutti i valori. Il punteggio resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッフルは数字を配り直します。スコアはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섞기는 모든 숫자를 다시 배치합니다. 점수는 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schudden verdeelt alle waarden opnieuw. Je score blijft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Embaralhar redistribui todos os valores. Sua pontuação é mantida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洗牌会重新分配所有数字，分数保留。"
          }
        }
      }
    },
    "booster.shuffle_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilt alle Werte neu. Dein Punktestand bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reshuffles every value on the board. Your score is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redistribuye todos los valores del tablero. Conservas tu puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redistribue toutes les valeurs de la grille. Ton score est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridistribuisce tutti i valori della griglia. Il punteggio resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤面の数字を配り直します。スコアはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판의 모든 숫자를 다시 섞습니다. 점수는 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeelt alle waarden opnieuw. Je score blijft behouden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redistribui todos os valores da grade. Sua pontuação é mantida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新分配棋盘上的所有数字，分数保留。"
          }
        }
      }
    },
    "game.no_boosters_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Booster kaufst du im Shop mit Münzen aus deinen Partien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boosters are bought in the shop with coins earned while playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los potenciadores se compran en la tienda con las monedas ganadas jugando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boosters s'achètent en boutique avec les pièces gagnées en partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I booster si comprano nel negozio con le monete guadagnate giocando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブースターはプレイで貯めたコインでショップから購入できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부스터는 플레이로 모은 코인으로 상점에서 구매할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boosters koop je in de winkel met munten die je al spelend verdient."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boosters são comprados na loja com as moedas ganhas jogando."
          }
        },
        "zh-Hans": {
