    "booster.hammer_coach": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe den Hammer an, dann die Blase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the hammer, then the bubble to pop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el martillo y luego la burbuja que quieras reventar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le marteau, puis la bulle à faire éclater."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il martello, poi la bolla da far scoppiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンマーを押してから、割りたいバブルを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "망치를 누른 뒤, 터뜨릴 방울을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de hamer en daarna op de bel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no martelo e depois na bolha a estourar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先点锤子，再点要击破的气泡。"
          }
        }
      }
    },
    "booster.hammer_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zerplatzt eine Blase deiner Wahl, der Rest fällt nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pops any bubble you pick; the rest fall down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revienta la burbuja que elijas; las demás caen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait éclater la bulle de ton choix, les autres retombent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa scoppiare la bolla che scegli, le altre cadono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなバブルを割ります。残りは下に落ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 방울을 터뜨립니다. 나머지는 아래로 떨어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een gekozen bel knappen; de rest valt naar beneden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoura a bolha que você escolher; as outras caem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击破任意气泡，其余气泡下落。"
          }
        }
      }
    },
    "booster.hammer_prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine Blase zum Zerstören an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a bubble to destroy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una burbuja para destruir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une bulle à détruire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una bolla da distruggere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壊すバブルをタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없앨 방울을 탭하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een bel om te vernietigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma bolha para destruir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击要消除的泡泡"
          }
        }
      }
    },
