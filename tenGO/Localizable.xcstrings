    "tutorial.step1_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe zurück, indem du erneut über\ndie letzte ausgewählte Blase fährst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back by passing over\nthe last selected bubble."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve atrás pasando de nuevo\nsobre la última burbuja seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens en arrière en repassant sur\nla dernière bulle sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna indietro passando di nuovo\nsull'ultima bolla selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に選んだバブルを通過すると\n戻ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 선택한 방울 위로\n다시 지나가면 뒤로 갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga terug door over de laatst\ngeselecteerde bel te bewegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte passando de novo pela\núltima bolha selecionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新滑过最后选中的泡泡\n即可撤回一步。"
          }
        }
      }
    },
    "tutorial.step1_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr, nicht weniger.\nDer Pfad kann 2 bis 9 Blasen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more, no less.\nThe path can have 2 to 9 bubbles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni más, ni menos.\nEl camino puede tener de 2 a 9 burbujas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas plus, pas moins.\nLe chemin peut avoir 2 à 9 bulles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Né più né meno.\nIl percorso può avere da 2 a 9 bolle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くても少なくてもダメ。\nつなげるのは2〜9個。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많아도, 적어도 안 돼요.\n경로는 2~9개의 방울까지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet meer, niet minder.\nHet pad kan 2 tot 9 bellen bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem mais, nem menos.\nO caminho pode ter de 2 a 9 bolhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不多不少。\n路径可以有 2 到 9 个泡泡。"
          }
        }
      }
    },
