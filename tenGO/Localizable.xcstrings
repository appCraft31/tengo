    "app.share_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke tenGO — ein Zen-Puzzle zum Durchatmen.\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover tenGO — a zen puzzle to breathe.\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre tenGO — un puzzle zen para respirar.\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre tenGO — un puzzle zen pour respirer.\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri tenGO — un puzzle zen per respirare.\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tenGOを発見 — 深呼吸のためのゼンパズル。\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tenGO 발견 — 숨 쉬게 하는 선(禪) 퍼즐.\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek tenGO — een zenpuzzel om adem te halen.\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubra tenGO — um puzzle zen para respirar.\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现 tenGO — 一款让你呼吸的禅意解谜。\n%@"
          }
        }
      }
    },
