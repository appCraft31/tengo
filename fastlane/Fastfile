  desc "Envoie les métadonnées (notes de version) sur App Store Connect — sans binaire ni screenshots"
  desc "Usage : bundle exec fastlane release_notes [version:1.8]"
  lane :release_notes do |options|
    version = options[:version] || get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    deliver(
      api_key: api_key,
      app_version: version,
      skip_binary_upload: true,
