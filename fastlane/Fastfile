  desc "Build et upload sur TestFlight"
  lane :beta do
    build_number = sh("git rev-list --count HEAD", log: false).strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "tenGO.xcodeproj"
    )

    build_app(
      workspace: "tenGO.xcworkspace",
      scheme: "tenGO",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    add_git_tag(tag: "build/#{version}-#{build_number}")
    push_git_tags
  end

  desc "Build et soumission App Store"
  lane :release do
    build_number = sh("git rev-list --count HEAD", log: false).strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "tenGO.xcodeproj"
    )

    build_app(
      workspace: "tenGO.xcworkspace",
      scheme: "tenGO",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    add_git_tag(tag: "release/#{version}-#{build_number}", force: true)
    push_git_tags
  end

