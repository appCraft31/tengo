default_platform(:ios)

platform :ios do

  desc "Build et upload sur TestFlight"
  lane :beta do
    build_number = sh("git rev-list --count HEAD", log: false).strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "tenGO.xcodeproj"
    )

    build_app(
      workspace: "tenGO.xcworkspace",
      scheme: "tenGO",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    add_git_tag(tag: "build/#{version}-#{build_number}")
    push_git_tags
  end

  desc "Build et soumission App Store"
  lane :release do
    build_number = sh("git rev-list --count HEAD", log: false).strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "tenGO.xcodeproj"
    )

    build_app(
      workspace: "tenGO.xcworkspace",
      scheme: "tenGO",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    add_git_tag(tag: "release/#{version}-#{build_number}")
    push_git_tags
  end

  desc "Met à jour MARKETING_VERSION — usage : bundle exec fastlane bump_version version:1.3"
  lane :bump_version do |options|
    version = options[:version]
    UI.user_error!("Passer version:X.Y en paramètre") unless version
    increment_version_number(
      version_number: version,
      xcodeproj: "tenGO.xcodeproj"
    )
    git_commit(
      path: "tenGO.xcodeproj/project.pbxproj",
      message: "chore(version): bump version to #{version}"
    )
  end

end
