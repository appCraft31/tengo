default_platform(:ios)

platform :ios do

  def api_key
    app_store_connect_api_key(
      key_id:       "U5B34558L6",
      issuer_id:    "69a6de88-d732-47e3-e053-5b8c7c11a4d1",
      key_filepath: "./fastlane/AuthKey_U5B34558L6.p8",
      duration:     1200,
      in_house:     false
    )
  end

  desc "Build et upload sur TestFlight"
  lane :beta do
    build_number = sh("git rev-list --count HEAD", log: false).strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "tenGO.xcodeproj"
    )

    build_app(
      workspace: "tenGO.xcworkspace",
      scheme: "tenGO",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    add_git_tag(tag: "build/#{version}-#{build_number}")
    push_git_tags
  end

  desc "Build et soumission App Store"
  lane :release do
    build_number = sh("git rev-list --count HEAD", log: false).strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "tenGO.xcodeproj"
    )

    build_app(
      workspace: "tenGO.xcworkspace",
      scheme: "tenGO",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_app_store(
      api_key: api_key,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    add_git_tag(tag: "release/#{version}-#{build_number}", force: true)
    push_git_tags
  end

  desc "Upload IPA uniquement (sans screenshots ni metadata) — après un release partiel"
  lane :upload_binary do
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      ipa: "tenGO.ipa"
    )

    version = get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    build_number = get_build_number(xcodeproj: "tenGO.xcodeproj")
    add_git_tag(tag: "release/#{version}-#{build_number}", force: true)
    push_git_tags
  end

  desc "Upload screenshots uniquement (sans build) — toutes les langues"
  lane :upload_screenshots do
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "Met à jour MARKETING_VERSION — usage : bundle exec fastlane bump_version version:1.3"
  lane :bump_version do |options|
    version = options[:version]
    UI.user_error!("Passer version:X.Y en paramètre") unless version
    increment_version_number(
      version_number: version,
      xcodeproj: "tenGO.xcodeproj"
    )
    git_commit(
      path: "tenGO.xcodeproj/project.pbxproj",
      message: "chore(version): bump version to #{version}"
    )
  end

  desc "Envoie les métadonnées (notes de version) sur App Store Connect — sans binaire ni screenshots"
  desc "Usage : bundle exec fastlane release_notes [version:1.8]"
  lane :release_notes do |options|
    version = options[:version] || get_version_number(xcodeproj: "tenGO.xcodeproj", target: "tenGO")
    deliver(
      api_key: api_key,
      app_version: version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Crée / met à jour les achats in-app (packs de pièces) depuis fastlane/iap/coin_packs.json"
  desc "Lecture seule par défaut. Pour appliquer : bundle exec fastlane iap_sync apply:true"
  desc "Note : `deliver` ne gère pas les IAP — on passe par l'API App Store Connect (Spaceship)."
  lane :iap_sync do |options|
    require "spaceship"
    require "json"

    apply = options[:apply].to_s == "true"
    fiche = JSON.parse(File.read("./fastlane/iap/coin_packs.json"))
    products = fiche["products"]

    # Authentification API (même clé que les autres lanes).
    token = Spaceship::ConnectAPI::Token.create(
      key_id:    "U5B34558L6",
      issuer_id: "69a6de88-d732-47e3-e053-5b8c7c11a4d1",
      filepath:  File.absolute_path("./fastlane/AuthKey_U5B34558L6.p8")
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find(fiche["app"]["bundleId"])
    UI.user_error!("App introuvable : #{fiche['app']['bundleId']}") if app.nil?

    existing = app.get_in_app_purchases.to_a
    existing_ids = existing.map(&:product_id)
    UI.message("IAP existants sur App Store Connect : #{existing_ids.empty? ? '(aucun)' : existing_ids.join(', ')}")

    products.each do |p|
      pid = p["productId"]
      already = existing.find { |e| e.product_id == pid }

      if already
        UI.success("✓ #{pid} existe déjà (#{p['referenceName']}) — prix cible #{p['priceUSD']} USD")
      elsif apply
        UI.message("→ Création de #{pid} (#{p['referenceName']})…")
        iap = Spaceship::ConnectAPI::InAppPurchaseV2.create(
          app_id: app.id,
          name: p["referenceName"],
          product_id: pid,
          in_app_purchase_type: p["type"],   # CONSUMABLE
          review_note: p["reviewNote"]
        )
        p["localizations"].each do |locale, loc|
          begin
            iap.create_localization(locale: locale, name: loc["name"], description: loc["description"])
          rescue => e
            UI.important("  ! localisation #{locale} non appliquée : #{e.message}")
          end
        end
        UI.success("✓ #{pid} créé. ⚠️ Définir le prix #{p['priceUSD']} USD dans App Store Connect (price points).")
      else
        UI.important("[dry-run] créerait #{pid} (#{p['referenceName']}, #{p['type']}, #{p['priceUSD']} USD) + #{p['localizations'].size} locales")
      end
    end

    UI.message("Terminé. #{apply ? 'Modifications appliquées.' : 'Lecture seule (relancer avec apply:true pour créer).'}")
    UI.important("Le prix (price points) et la disponibilité par territoire restent à confirmer dans App Store Connect.")
  end

end
