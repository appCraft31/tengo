<?xml version="1.0" encoding="utf-8"?>
<!-- Module Android de tenGO (Unity), fusionné dans le manifeste de l'app :
     permissions et id Play Games de l'app Kotlin 3.3.0. L'id AdMob vient du
     plugin Google Mobile Ads, les liens profonds d'Editor/AndroidPostprocess.cs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.appcraft31.tengo.unitylib">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- Référence de ressource obligatoire : en valeur littérale, l'id
             numérique serait lu comme un entier et Play Games refuserait de démarrer. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
    </application>
</manifest>
